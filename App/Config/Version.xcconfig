// Generated by `make gen` (see the Makefile's version target) from
// `git rev-list --count HEAD` — the build number App Store Connect sorts
// uploads by. Committed so a bare `xcodegen generate` still resolves it;
// the value is refreshed on every `make gen`, and the number that matters
// is the one in the archive.
//
// MARKETING_VERSION lives in project.yml. A target-level build setting
// beats an xcconfig, so CURRENT_PROJECT_VERSION must NOT be set there.
CURRENT_PROJECT_VERSION = 262
